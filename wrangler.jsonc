{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "master-thesis",
	"compatibility_date": "2026-10-18",
	// Static-assets-only Worker: no server code runs, files are served from Cloudflare's edge.
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "master-thesis.nyggis.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true
}
